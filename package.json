{
  "name": "jfranciscosousa.com",
  "private": true,
  "scripts": {
    "clean": "rm -rf .astro dist node_modules",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build-prod": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "ts-check": "astro sync && tsc --noEmit --skipLibCheck",
    "a11y": "pa11y-ci dist/*.html dist/**/*.html dist/**/**/*.html",
    "ci": "npm run lint && npm run ts-check && npm run build-prod && npm run a11y"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/xml2js": "^0.4.14",
    "pa11y-ci": "^4.1.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "astro-remote": "^0.3.4",
    "date-fns": "^4.4.0",
    "markdown-it": "^15.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "prettier": "^3.9.6",
    "rel-to-abs": "^0.1.0",
    "remark-code-titles": "^0.1.2",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "xml2js": "^0.6.2"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22.x"
  }
